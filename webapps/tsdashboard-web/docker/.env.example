# Required. Host port that publishes the dashboard UI over HTTPS.
# Port 443 on the tscharts host is the API. Choose this port at deploy time.
HOST_HTTPS_PORT=
# Required. Port the app listens on inside the compose network. Not published.
# Compose always binds 0.0.0.0:$APP_PORT so nginx in this stack can reach the app.
APP_PORT=
# Session cookie Secure flag. 1 when browsers use https:// (this compose file).
SESSION_COOKIE_SECURE=1

# --- Mode A: remote / same host via public HTTPS (tablet-style) ---
# Use the EC2 public/private IP or DNS. From a container on the same host,
# prefer host.docker.internal or the host LAN IP — not 127.0.0.1.
TSCHARTS_BASE_URL=https://host.docker.internal
TSCHARTS_TLS_INSECURE=1

# --- Mode B: same Docker network as tscharts (internal HTTP) ---
# Use with: docker compose -f docker-compose.yml -f docker-compose.tscharts-net.yml up -d
# TSCHARTS_BASE_URL=http://django:8000
# TSCHARTS_TLS_INSECURE=0
# TSCHARTS_COMPOSE_NETWORK=docker_app-network

RUST_LOG=info
