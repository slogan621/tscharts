# Copy to docker/backup.env and set the bucket prefix. That file is not committed.
#
# Objects are written as:
#   $S3_PREFIX/tscharts-YYYY-MM-DD.sql.gz
#   $S3_PREFIX/tscharts-images-YYYY-MM-DD-full.tar.gz
#   $S3_PREFIX/tscharts-images-YYYY-MM-DD-incr.tar.gz
#   $S3_PREFIX/tscharts-images.toc
S3_PREFIX=s3://YOUR_BUCKET/tscharts

# Named volume mounted on the django container at /opt/thousandsmiles/images.
IMAGE_VOLUME=docker_chart_images

# Used only when the job runs as root. The installed cron job runs as ubuntu.
AWS_CONFIG_HOME=/home/ubuntu
