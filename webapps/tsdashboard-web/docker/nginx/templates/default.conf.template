# TLS for the clinic dashboard. The image entrypoint substitutes APP_PORT.
# Published on HOST_HTTPS_PORT. Host port 443 stays the tscharts API.

upstream tsdashboard_web {
    server tsdashboard-web:${APP_PORT};
}

server {
    listen 443 ssl;
    server_name _;

    ssl_certificate /etc/nginx/ssl/dashboard.pem;
    ssl_certificate_key /etc/nginx/ssl/dashboard-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 50m;

    location / {
        proxy_pass http://tsdashboard_web;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }
}
