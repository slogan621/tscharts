# Base URL of the tscharts API (no trailing slash), as seen from this app.
TSCHARTS_BASE_URL=https://127.0.0.1

# Bind address for a local cargo run. Change the port, and the IP if you
# do not want every interface (for example 127.0.0.1:1234).
# If this is unset, APP_PORT is used instead and the process binds 0.0.0.0.
LISTEN_ADDR=0.0.0.0:1234

# Set to 1 to allow self-signed / mkcert upstream TLS (local dev only)
TSCHARTS_TLS_INSECURE=1

# Optional: REST print agent for wristbands (later)
# PRINT_AGENT_URL=http://127.0.0.1:3100
