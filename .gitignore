# Python
*.pyc
__pycache__/
.venv/

# Local credentials (docker/README: cp .env.example .env)
.env
.env.*
!.env.example
docker/backup.env

# Database dumps — private data; never commit
*.sql

# docker compose up --profile debug (traffic-monitor)
docker/tcpdump_data/*
!docker/tcpdump_data/.gitkeep
*.pcap

# Django collectstatic output (STATIC_ROOT) — do not ignore webapps/*/static/
/static/
/staticfiles/

# Editor temporaries
*.swp
